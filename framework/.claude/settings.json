{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-start.mjs",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node .claude/hooks/tower-card.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/now.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-bash.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-edit.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*__create_session|mcp__github__merge_pull_request|mcp__github__pull_request_read|mcp__.*__fire_trigger",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-mcp.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-stop.mjs",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__github__create_pull_request|mcp__.*__fire_trigger",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-mcp.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "autoCompactWindow": 300000
}
